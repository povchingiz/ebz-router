# ==============================================================================
# ЕОТИНІШ / ЕБЗ ПЛАТФОРМА — КОНФИГУРАЦИЯ ЗАКРЫТОГО КОНТУРА (ЕТС ГО / АО "НИТ")
# ==============================================================================

# Серверные порты
APP_PORT=3050
DB_PORT=5432

# База данных PostgreSQL (27,164 организаций и классификатор ЕБЗ)
DB_USER=eotinish_platform
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_NAME=eotinish_ai_demo
DATABASE_URL=postgresql://eotinish_platform:CHANGE_ME_strong_db_password@ebz-db:5432/eotinish_ai_demo

# Безопасность и Доступ
# ВСЕ значения ниже обязательны: без них приложение не стартует / compose откажется запускаться.
SITE_GATE_PASSWORD=CHANGE_ME_gate_password
# Ключ подписи сессий и site-gate: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32
# Учётные записи (JSON, одной строкой в одинарных кавычках). Роли: GLOBAL_ADMIN | ORG_ADMIN | VIEWER.
# Хеш пароля: node scripts/hash_password.mjs  (формат scrypt:<salt>:<hash>)
EBZ_PRESET_USERS='[{"login":"superadmin","role":"GLOBAL_ADMIN","passwordHash":"CHANGE_ME_run_hash_password_mjs","fullName":"Супер-администратор","orgId":"ap","orgName":"Администрация Президента"}]'
# Разрешённые CORS-источники через запятую (пусто = только same-origin)
ALLOWED_ORIGINS=
# true — только если приложение стоит за доверенным reverse proxy (учёт X-Forwarded-For в rate limit)
TRUST_PROXY=false
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ИИ-маршрутизатор в закрытой сети
# Если развернут локальный vLLM / Ollama (например, Qwen 2.5 14B / 32B в контуре ЦОД):
AI_GATEWAY_URL=http://localhost:11434
# Если ИИ-модель отсутствует, система автоматически использует встроенный детерминированный
# движок маршрутизации (Fast Rule-based & Token Matcher) с нулевой внешней зависимостью.
